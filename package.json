{
  "name": "webmcp-safety-check",
  "version": "1.0.1",
  "description": "Local-first safety declaration checker for WebMCP and MCP browser tools",
  "type": "module",
  "license": "MIT",
  "bin": {
    "webmcp-safety-check": "dist/cli/webmcp-safety-check.mjs"
  },
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "preview": "node scripts/preview-site.mjs",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:site": "npm run clean && npm run build:extension && npm run build:cli && wxt zip && vite build --config vite.site.config.ts && node scripts/build-service-worker.mjs && node scripts/package-artifacts.mjs",
    "package:extension": "wxt zip && node scripts/package-artifacts.mjs",
    "build": "npm run build:site",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:extension": "npm run build && xvfb-run -a node tests/extension-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.3",
    "esbuild": "0.25.3",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.58.2"
    }
  }
}
